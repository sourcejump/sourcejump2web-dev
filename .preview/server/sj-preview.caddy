# Preview sites at <name>-sj.okwhiteli.st. install.sh puts this at /etc/caddy/sj-preview.caddy; the main
# Caddyfile imports it. Traffic comes from cloudflared on loopback, as with upstream's Caddyfile.
# Sites with a more specific address (e.g. foo.okwhiteli.st) still win over this wildcard.
http://*.okwhiteli.st {
	bind 127.0.0.1
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@preview header_regexp pv Host ^([a-z0-9-]+)-sj\.okwhiteli\.st$
	handle @preview {
		# Each line of ports.map is "<name> <port>", written by sj-preview.
		map {re.pv.1} {sjp_port} {
			import /srv/sj-preview/ports.map
			default 0
		}

		@unknown vars {sjp_port} 0
		handle @unknown {
			respond "No preview with this name." 404
		}

		# The browser calls /v1/* on the site's own origin (web/src/api/client.ts). Previews read real data from
		# the shared API but can never write to it. Cookies are dropped both ways, so sign-in can't happen on
		# preview code.
		@api path /v1/* /health
		handle @api {
			@write not method GET HEAD
			respond @write "Previews are read-only." 405
			reverse_proxy {$SJP_API_URL:https://beta.sourcejump.net} {
				header_up Host {upstream_hostport}
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
				header_down -Set-Cookie
			}
		}

		handle {
			reverse_proxy 127.0.0.1:{sjp_port}
		}
	}

	handle {
		respond 404
	}
}
